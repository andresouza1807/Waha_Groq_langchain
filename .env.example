# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real secrets to version control

# Groq LLM Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Evolution API Configuration (REQUIRED)
# Evolution API URL (use http://evolution:3333 in docker compose)
EVOLUTION_API_URL=http://evolution:3333
# Get your API key from Evolution API dashboard
EVOLUTION_API_KEY=sk_test_your_api_key_here
# Your WhatsApp instance name in Evolution API
EVOLUTION_INSTANCE_NAME=default
