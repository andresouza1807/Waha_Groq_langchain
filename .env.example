# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real secrets to version control

# Groq LLM Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# WAHA Configuration (DEPRECATED - Use Evolution API instead)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_dashboard_password_here
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=your_swagger_password_here

# Evolution API Configuration (RECOMMENDED)
# Evolution API URL (use http://evolution:3333 in docker-compose)
EVOLUTION_API_URL=http://evolution:3333
# Get your API key from Evolution API dashboard
EVOLUTION_API_KEY=sk_test_your_api_key_here
# Your WhatsApp instance name in Evolution API
EVOLUTION_INSTANCE_NAME=default

# Legacy WAHA Configuration (optional)
# WAHA_URL=http://wpp_bot_waha:3000
# WAHA_SESSION_NAME=default
WAHA_API_KEY=your_waha_api_key_here

# Feature Flags
# Use Evolution API instead of WAHA (default: true)
USE_EVOLUTION_API=true
